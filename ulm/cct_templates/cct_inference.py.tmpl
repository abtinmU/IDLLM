                  torch_dtype=torch.bfloat16,device_map='auto',attn_implementation='sdpa',trust_remote_code=False)
@@POST_LOAD@@
  actual=getattr(self.model.config,'_commit_hash',None)
  assert not actual or actual==REVISION,('Wrong model revision',actual)
  self.torch=torch;self.loaded=True
  self.hardware={'gpu':torch.cuda.get_device_name(0),'cuda_capability':[props.major,props.minor],
      'torch':torch.__version__,'transformers':transformers.__version__,
      'dtype':'bfloat16','attention':'sdpa','device_map':'auto',
      'model_revision':REVISION,'torch_tf32':torch.backends.cuda.matmul.allow_tf32,
      'decoding':'greedy','chat_template':'tokenizer.apply_chat_template(user,add_generation_prompt=True)'}
  savejson(self.work/'hardware_manifest.json',self.hardware)
  print('LOADED',self.hardware)
@@STOP_IDS_METHOD@@ def encode(self,p,max_input):
  enc=self.tok.apply_chat_template([{'role':'user','content':p}],add_generation_prompt=True,
                tokenize=True,return_dict=True,return_tensors='pt')
  n=int(enc['input_ids'].shape[-1]);assert n<=max_input,(n,max_input)
  device=self.model.get_input_embeddings().weight.device
