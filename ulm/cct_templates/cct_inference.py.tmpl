  return item,False
 def get_state(self,r):
  p_hash=r['prompt_sha256'];fp={'prompt_sha256':p_hash,'model_revision':REVISION,
      'layers':@@LAYERS_LIST@@,'dtype':'bfloat16','max_input_tokens':int(r.get('max_input_tokens',1024)),
      'chat_template':'apply_chat_template_user_add_generation_prompt','attention':'sdpa'}
  key=digest(canon(fp).encode())[:32]
  path=self.statedir/(key+'.npz');meta=self.statedir/(key+'.json')
  if path.exists() and meta.exists():
   assert json.loads(meta.read_text())==fp
   with np.load(path,allow_pickle=False) as z:state=z['states']
   assert state.shape==(3,@@HIDDEN_WIDTH@@) and np.isfinite(state).all()
   return state.astype(np.float32),True
  self.load();enc,n=self.encode(r['prompt'],int(r.get('max_input_tokens',1024)))
  with self.torch.inference_mode():
   out=self.model(**enc,output_hidden_states=True,use_cache=False,return_dict=True)
   state=np.stack([out.hidden_states[j][0,-1].float().cpu().numpy() for j in @@LAYERS_TUPLE@@]).astype(np.float16)
  assert state.shape==(3,@@HIDDEN_WIDTH@@) and np.isfinite(state).all()
  temp=path.with_name(path.name+'.tmp')
  with open(temp,'wb') as f:np.savez_compressed(f,states=state)
  os.replace(temp,path);savejson(meta,fp)
  del out,enc
  return state.astype(np.float32),False
 def task_only_state(self,base_task,max_input,source_id):
  fake={'prompt':base_task,'prompt_sha256':hash_prompt(base_task),'max_input_tokens':max_input}
  z,_=self.get_state(fake)
  return z[0]
 def run(self,rows,out,max_cases=None):
  from collections import Counter
  out=Path(out);out.mkdir(parents=True,exist_ok=True)
  rows=rows[:max_cases] if max_cases else rows
  saved=[];reuse_gen=0;reuse_state=0
  for k,r in enumerate(rows):
   a,rg=self.get_response(r);z,rs=self.get_state(r)
   reuse_gen+=rg;reuse_state+=rs
   record={field:a[field] for field in ['id','label','original_grade_same_response','tokens','input_tokens','capped','response','prompt_sha256']}
   record.update({v:r[v] for v in ['section','task_id','condition','fold','task_family_id','instruction_type']})
   record['family_uid']= ('simple_' if r['section'] in 'AB' else 'derived_')+str(r['task_id'])
   record['type']=r['instruction_type'];record['dataset']='IFEval-Simple' if r['section'] in 'AB' else 'IFEval-derived'
   saved.append(record)
   if (k+1)%20==0 or k+1==len(rows):
    print(f'CCT progress {k+1}/{len(rows)} | cached generations {reuse_gen} | cached states {reuse_state}',flush=True)
    with (out/'INFERENCE_PROGRESS.jsonl').open('w') as f:
     for x in saved:f.write(json.dumps(x,ensure_ascii=False)+'\n')
    savejson(out/'INFERENCE_PROGRESS.json',{'completed':k+1,'total':len(rows),
     'cached_generations':reuse_gen,'cached_states':reuse_state})
   if (k+1)%80==0:
    gc.collect();self.torch.cuda.empty_cache()
  assert len(saved)==len(rows)
  return saved
