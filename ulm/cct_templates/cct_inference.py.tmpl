 def gen_cache_keys(self,r):
  args={'prompt_sha256':r['prompt_sha256'],'model':REVISION,'dtype':'bfloat16','sdpa':True,
        'generation_budget':int(r['generation_budget']),'max_input_tokens':int(r.get('max_input_tokens',1024)),
        'chat_template':'apply_chat_template_user_add_generation_prompt','greedy':True,
        'verifier_sha':VERIFIER_SHA,'type':r['instruction_type'],'kwargs':r['target_kwargs']}
  return args,digest(canon(args).encode())[:32]
 def get_response(self,r):
  args,key=self.gen_cache_keys(r);path=self.gendir/(key+'.json')
  if path.exists():
   item=json.loads(path.read_text());assert item['cache_args']==args and item['prompt_sha256']==r['prompt_sha256']
   assert item['label']==self.check(r['instruction_type'],r['target_kwargs'],item['response'])
   return item,True
  self.load();t=self.torch
  enc,n=self.encode(r['prompt'],int(r.get('max_input_tokens',1024)))
  with t.inference_mode():
   gen=self.model.generate(**enc,max_new_tokens=int(r['generation_budget']),do_sample=False,num_beams=1,
                   use_cache=True,@@GEN_STOP_KW@@)
  ids=gen[0,n:].detach().cpu().tolist();k=len(ids)
  response=self.tok.decode(ids,skip_special_tokens=True).strip()
@@END_IDS@@
  capped=int(k>=int(r['generation_budget']) and (not ids or ids[-1] not in end_ids))
  label=self.check(r['instruction_type'],r['target_kwargs'],response)
  original_grade=self.check(r['instruction_type'],r['original_kwargs'],response)
  item={'id':r['id'],'prompt_sha256':r['prompt_sha256'],'response':response,
        'generated_token_ids':ids,'label':label,'original_grade_same_response':original_grade,
        'tokens':k,'input_tokens':n,'capped':capped,'cache_args':args}
